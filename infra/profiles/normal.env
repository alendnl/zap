# ==============================================================================
# PROFILE: NORMAL (Scale-Down / Everyday Mode)
# ==============================================================================
# - Scale to zero when idle ($0 idle compute cost)
# - Sized for day-to-day student practice, question authoring, and admin tasks.
# ==============================================================================

PROFILE_NAME=normal

# --- zap-api (REST Gateway) ---
API_CPU=1
API_MEMORY=1Gi
API_MIN_INSTANCES=0
API_MAX_INSTANCES=5
API_CONCURRENCY=40
API_CONCURRENCY_TARGET=0.80

# --- zap-executor (Code Runner Subsystem) ---
EXECUTOR_CPU=2
EXECUTOR_MEMORY=2Gi
EXECUTOR_MIN_INSTANCES=0
EXECUTOR_MAX_INSTANCES=5
EXECUTOR_CONCURRENCY=4
EXECUTOR_CONCURRENCY_TARGET=0.40
EXECUTOR_TIMEOUT=120

# --- zap-submissions (Cloud Tasks Queue) ---
TASKS_MAX_RATE=5.0
TASKS_MAX_CONCURRENT=10
TASKS_MAX_ATTEMPTS=3
