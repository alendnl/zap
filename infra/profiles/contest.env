# ==============================================================================
# PROFILE: CONTEST (High-Concurrency Assessment Mode)
# ==============================================================================
# - Pre-warmed instances to eliminate cold starts
# - High CPU & RAM to handle simultaneous compilation bursts (C++, Java JVM)
# - High Cloud Tasks dispatch rates to prevent queue backlog
# ==============================================================================

PROFILE_NAME=contest

# --- zap-api (REST Gateway) ---
API_CPU=2
API_MEMORY=2Gi
API_MIN_INSTANCES=2
API_MAX_INSTANCES=15
API_CONCURRENCY=40
API_CONCURRENCY_TARGET=0.80

# --- zap-executor (Code Runner Subsystem) ---
EXECUTOR_CPU=4
EXECUTOR_MEMORY=4Gi
EXECUTOR_MIN_INSTANCES=3
EXECUTOR_MAX_INSTANCES=25
EXECUTOR_CONCURRENCY=8
EXECUTOR_CONCURRENCY_TARGET=0.40
EXECUTOR_TIMEOUT=120

# --- zap-submissions (Cloud Tasks Queue) ---
TASKS_MAX_RATE=10.0
TASKS_MAX_CONCURRENT=40
TASKS_MAX_ATTEMPTS=3
